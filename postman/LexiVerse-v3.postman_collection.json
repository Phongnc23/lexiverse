{
  "info": {
    "_postman_id": "5ee562fa-15ca-42e9-b027-abc99a5e8cf2",
    "name": "LexiVerse 3.0 — REST API (localhost)",
    "description": "Cập nhật cho LexiVerse V2. Chạy đăng nhập demo, /api/me để lấy cookie + CSRF trước. Tệp CSV chọn thủ công trong Postman Body > form-data > file. Chế độ thẻ chỉ nhận mixed/spelling/reading. V3 thêm API bộ thẻ luyện tập cá nhân, chỉ người sở hữu bài truy cập.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 · Kết nối và đăng nhập",
      "item": [
        {
          "name": "01 · Kiểm tra API config",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/config",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Config có demoLogin\", () => pm.expect(pm.response.json()).to.have.property(\"demoLogin\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 · Đăng nhập demo (chỉ localhost)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/demo",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Postman tự lưu cookie HttpOnly lx_session từ response. Chỉ hoạt động ở localhost với APP_ENV=development, DEV_DEMO_LOGIN=true."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 · Lấy thông tin & tự lưu CSRF",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/me",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const data = pm.response.json(); if (data.csrf) pm.environment.set(\"csrf\", data.csrf); }",
                  "pm.test(\"Có csrf\", () => pm.expect(pm.response.json().csrf).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
