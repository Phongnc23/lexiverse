          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/lessons/{{lessonId}}/words/template",
            "description": "Tải template bằng Save Response to a file, có đúng 5 cột. Yêu cầu cookie đăng nhập teacher."
          },
          "response": []
        },
        {
          "name": "09b · Import từ vựng CSV hàng loạt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": "{{baseUrl}}/api/lessons/{{lessonId}}/words/import",
            "description": "Chọn file CSV UTF-8 theo template ở Body → form-data → file. Không đặt Content-Type thủ công; Postman tự tạo multipart boundary. 2 MB, 1000 dòng, bỏ qua từ trùng."
          },
          "response": []
        }
      ]
