    {
      "name": "07 · Luyện tập tích hợp V3",
      "item": [
        {
          "name": "Bộ thẻ luyện tập — Hỗn hợp",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/practice/lessons/{{lessonId}}/cards?mode=mixed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "practice",
                "lessons",
                "{{lessonId}}",
                "cards"
              ],
              "query": [
